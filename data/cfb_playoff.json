e":0.001,"cfp":0.0,"bye":0.0,"qf":0.0,"semi":0.0,"final":0.0,"title":0.0,"avgSeed":null},{"id":"2751","conf":"MWC","rating":-8.37,"wins":7.5,"losses":4.9,"bowl":1.0,"ccg":0.42,"conf_title":0.088,"cfp":0.0,"bye":0.0,"qf":0.0,"semi":0.0,"final":0.0,"title":0.0,"avgSeed":null}],"bracket":[{"seed":1,"id":"61","auto":true},{"seed":2,"id":"87","auto":false},{"seed":3,"id":"2390","auto":true},{"seed":4,"id":"254","auto":true},{"seed":5,"id":"84","auto":true},{"seed":6,"id":"333","auto":false},{"seed":7,"id":"26","auto":false},{"seed":8,"id":"68","auto":true},{"seed":9,"id":"251","auto":false},{"seed":10,"id":"2294","auto":false},{"seed":11,"id":"2633","auto":false},{"seed":12,"id":"2335","auto":false}],"method":"CFB season simulator: conference titles, 12-team College Football Playoff, national title odds.\n\nEach simulated season:\n  1. Every team gets a season-long rating shock ~ N(0, 3.5): we don't know any team's true\n     strength exactly, and that uncertainty is shared across all of its remaining games.\n  2. Every remaining game is played: P(home) = Phi((r_h - r_a + hfa) / 15.8), the same sigma the\n     model uses everywhere (injury / QB adjustments included).\n  3. Conference title games: top two in conference win %, ties broken by overall record then\n     (noisy) rating as a stand-in for real tiebreakers, played at a neutral site.\n  4. Committee proxy: r\u00e9sum\u00e9 score = simulated rating - 6 x losses + 3 for a conference title.\n     One loss is worth about a touchdown of rating, which tracks how committees have ranked.\n  5. 12-team field (2025+ format): the five highest-ranked conference champions plus the seven\n     best remaining, seeded straight by r\u00e9sum\u00e9; seeds 1-4 get byes, 5-8 host first-round games,\n     everything after is neutral.\nFCS opponents are a flat -22. All of this is a model of the committee, not the committee."}